@article{oliverLanguageDevelopmentChildren1994,
  title = {The Language Development of Children with {{Down}}'s Syndrome: {{First}} Words to Two-Word Phrases},
  author = {Oliver, Bonamy and Buckley, Sue},
  date = {1994},
  journaltitle = {Down Syndrome Research and Practice},
  volume = {2},
  number = {2},
  pages = {71--75},
  issn = {0968-7912},
  doi = {10.3104/reports.33},
  url = {http://www.down-syndrome.org/reports/33/},
  abstract = {Conducted a longitudinal study to investigate the early language development of 17 children (aged 1–4 yrs at beginning of study) with Down's syndrome (DS). Using parental records of their children's speech, language development data were collected from first words to the consolidation of 2-word phrases. The mean age for reaching the 10-word stage was 27.3 mo, a delay of around 12 mo. Results show that the DS children studied here learned very similar words to those of typically developing children. The results also indicate that, as with typically developing children, some DS children experienced a "vocabulary explosion". The mean age for this language explosion was 30 mo, with a mean vocabulary of 24.4 words. However, it was clear that there was a wide range of individual differences with some children showing no "explosion". The mean age for 2-word phrase consolidation was 36.9 mo, suggesting a delay of around 18 mo. Having reached the 10-word stage, DS children proceed in their language development at a slower rate to a 2-word stage than typically developing children. Detailed individual profiles are included to illustrate the wide range of individual differences observed in the rate of language acquisition in this group. (PsycINFO Database Record (c) 2010 APA, all rights reserved)},
  file = {C\:\\Users\\FrankBuckley\\Zotero\\storage\\7MNCFGE8\\full-text.pdf;C\:\\Users\\FrankBuckley\\Zotero\\storage\\F3UMN2AA\\1994 Oliver Buckley Combining words DSRP.pdf}
}

@article{kaat-vandenosExpressiveVocabularyDevelopment2017,
  title = {Expressive {{Vocabulary Development}} in {{Children With Down Syndrome}}: {{A Longitudinal Study}}: {{Vocabulary Growth}} and {{Profiles}}},
  shorttitle = {Expressive {{Vocabulary Development}} in {{Children With Down Syndrome}}},
  author = {Kaat-van Den Os, Danielle Te and Volman, Chiel and Jongmans, Marian and Lauteslager, Peter},
  date = {2017-12},
  journaltitle = {Journal of Policy and Practice in Intellectual Disabilities},
  shortjournal = {Journal of Policy and Practice in Intellectual Disabilities},
  volume = {14},
  number = {4},
  pages = {311--318},
  issn = {17411122},
  doi = {10.1111/jppi.12212},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/jppi.12212},
  urldate = {2023-06-21},
  abstract = {Children with Down syndrome (DS) show a significant delay in their language development, in particular in expressive language. Although many studies have described the development of spoken language skills of children with DS, not many investigated the development of gestures and spoken words more in detail. The aim of this study was to describe the expressive vocabulary development of young children with DS with regard to the nature of vocabulary growth and modality (gesture- and/or verbal production). In addition, the association between cognitive development and vocabulary growth was examined. The study included 26 children with DS aged between 18 and 24 months (age at start: M 5 19.5, SD 5 2.1). Expressive vocabulary growth (gestures and spoken words) was longitudinally followed over an 18-month period based on monthly administrations of the Lexi questionnaire. Cognition was determined with the Cognition Scale of the Bayley-III-NL. First, three different vocabulary growth patterns were observed: marginal vocabulary growth (n 5 8), vocabulary growth without a spurt (n 5 9), and vocabulary growth spurt (n 5 9). The average level of cognition of the group of children with a marginal vocabulary growth pattern was significantly lower compared to that of the other two growth pattern groups. Second, between the age of 18 and 33 months, two different modality profiles were observed: predominant use of gestures (G), and use of gestures plus spoken words (GS). Two children changed from a G profile to a GS profile, two children changed from a GS profile to a predominant spoken word (S) profile. In line with earlier studies, the present study underscores the individual variability in expressive vocabulary growth patterns, and in modality profiles of children with DS. The relation of these individual differences to the children’s level of cognition, as well as the relation between the different growth patterns and the different modality profiles are discussed.},
  langid = {english},
  keywords = {Children,Down syndrome,Gestures,Intellectual disabilities,Vocabulary},
  file = {C:\Users\FrankBuckley\Zotero\storage\ERX3IT2A\full-text.pdf}
}

@article{galeoteAcquisitionProductiveVocabulary2008,
  title = {The Acquisition of Productive Vocabulary in {{Spanish}} Children with {{Down}} Syndrome},
  author = {Galeote, Miguel and Soto, Pilar and Checa, Elena and Gómez, Aurora and Lamela, Elena},
  date = {2008-12},
  journaltitle = {Journal of Intellectual \& Developmental Disability},
  shortjournal = {Journal of Intellectual \& Developmental Disability},
  volume = {33},
  number = {4},
  pages = {292--302},
  issn = {1366-8250, 1469-9532},
  doi = {10.1080/13668250802441870},
  url = {https://www.tandfonline.com/doi/full/10.1080/13668250802441870},
  urldate = {2023-06-21},
  abstract = {Background It is generally assumed that children with Down syndrome (DS) present a deficit in lexical production relative to their cognitive abilities. However, the literature on this topic has recently shown several contradictory results. In addition, most studies only consider vocabulary production in its vocal modality. However it is also necessary to take into account gesture production, since this is a strength in children with DS. Our main purpose in this study, therefore, was to investigate the relationship between cognitive development and vocabulary size in both its vocal and gestural modalities in a broad sample of Spanish children with DS. Method Participants in the study were 66 children with DS and 66 children with typical development (TD), with a mental age (MA) of 14–28 months (divided into five groups with a MA of 14–16, 17–19, 20–22, 23–25 and 26–28 months). Children were matched on the basis of their gender and MA. Productive vocabularies were collected using an adaptation of the MacArthur-Bates CDI for children with DS. Results In vocal modality, the number of words produced by children with DS and children with TD is similar. As in previous studies, our data confirmed that gestural communication is superior in children with DS. However, when words and gestures are combined, the performance of both groups of children is practically equal. Conclusion Our results do not support a specific dissociation between cognitive and lexical development in children with DS.},
  langid = {english},
  keywords = {Age Factors,Child Behavior,Child Behavior: psychology,Child Language,Child Preschool,Cognition,Down Syndrome,Down Syndrome: physiopathology,Down Syndrome: psychology,Female,Gestures,Humans,Infant,Language Development,Male,Parents,Spain,Vocabulary},
  file = {C:\Users\FrankBuckley\Zotero\storage\BEZZRWD6\full-text.pdf}
}

