  title = {Explaining the {{Comprehension}}–{{Production Vocabulary Gap Through Neural Networks}} and {{Cross-Syndrome Evidence}}: {{Insights From Williams Syndrome}}},
  shorttitle = {Explaining the {{Comprehension}}–{{Production Vocabulary Gap Through Neural Networks}} and {{Cross-Syndrome Evidence}}},
  author = {D'Souza, Dean and D'Souza, Hana and Mayor, Julien and Tovar, Ángel Eugenio},
  date = {2026},
  journaltitle = {Developmental Science},
  volume = {29},
  number = {2},
