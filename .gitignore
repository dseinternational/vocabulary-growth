outputs/
# No trailing slash: match both an output directory and a symlink. An unignored
# link would mark the checkout and any fit provenance dirty.
output
figures/

# Comparison inputs and rendered assets are staged beside index.qmd. They are
# generated; leaving them unignored would mark fit provenance dirty.
docs/comparison/*.csv
docs/comparison/*.png
docs/comparison/*.svg
docs/comparison/index.html
docs/comparison/index_files/

# The standalone descriptive report also renders beside its source.
docs/descriptive/index.html
docs/descriptive/index_files/

# Quarto/LaTeX byproducts beside the report source. Deliverables belong in the
# output directory configured by docs/report/_quarto.yml.
docs/report/index.aux
docs/report/index.html
docs/report/index.tex
docs/report/index.toc
docs/report/index.pdf
