outputs/
# No trailing slash: `output` is a SYMLINK to a scratch volume on the fitting
# VM (2026-08-17), and `output/` matches only a real directory. Left as it was,
# the link showed as untracked, which made the checkout dirty and stamped
# `dirty: true` into the provenance block of every fit started from it --
# the defect that made the vg11 anchor-broad manifest unclean. Matches both
# a directory and a link.
output
figures/

# Standalone comparison-doc render artifacts. The comparison suite writes its
# tables to output/comparisons/; docs/comparison/index.qmd reads them by bare
# name, so they are staged next to the doc at render time (with the rendered
# index.html + index_files/). The plot copies (.png/.svg) are staged the same
# way. All generated — never committed. (Leaving the plots untracked previously
# flagged fit manifests as dirty because git_metadata counts untracked files.)
docs/comparison/*.csv
docs/comparison/*.png
docs/comparison/*.svg
docs/comparison/index.html
docs/comparison/index_files/

# Quarto/LaTeX render byproducts staged next to docs/report/index.qmd. The book
# renders to the output root (see _quarto.yml's output-dir), so an index.html
# here is a leftover from an older render, not a deliverable -- but it is
# untracked and in the working tree, so a `git add -A` picks it up. That
# happened on 2026-08-19 and it took a later render deleting the file to notice.
docs/report/index.aux
docs/report/index.html
docs/report/index.tex
docs/report/index.toc
docs/report/index.pdf
_freeze/
_temp/
temp/
tmp/

*.ipynb

*.log
*.duckdb
*.db

.quarto/
**/*.quarto_ipynb
**/*.quarto_ipynb_*


